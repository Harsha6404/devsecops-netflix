        }

        stage('Terraform validate') {
            steps {
                dir('EKS_TERRAFORM') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform plan') {
            steps {
                dir('EKS_TERRAFORM') {
                    sh 'terraform plan'
                }
            }
        }

        stage('Terraform apply/destroy') {
            steps {
                dir('EKS_TERRAFORM') {
                    sh "terraform ${params.action} --auto-approve"
                }
            }
        }
    }
}
